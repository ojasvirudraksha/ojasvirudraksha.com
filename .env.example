# App (local development)
OJASVIRUDRAKSHA_PORT=8000
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Blank uses the existing persistent key in .local/django-secret-key.
DJANGO_SECRET_KEY=
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=Asia/Kolkata

# Database (mysql is the Docker service name; 3306 is its internal port)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ojasvirudraksha
MYSQL_USER=ojasvirudraksha
MYSQL_PASSWORD=ojasvirudraksha_local
MYSQL_ROOT_PASSWORD=root_local

# Email (saved locally by default; use smtp.EmailBackend for delivery)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="OJASVIRUDRAKSHA <noreply@localhost>"
